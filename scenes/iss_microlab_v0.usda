                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (1.45, -1.07, -0.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }

        def Xform "Waypoints"
        {
            def Sphere "R2_Park" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom token iss:affordance = "approach_park"
                custom rel iss:graspCandidates = </World/Environment/ISS/Affordances/Handrail_B_Graspable>
                rel material:binding = </World/Looks/AffordanceWaypoint>
                double radius = 0.035
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.78, -0.5, 0.08)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
        }
    }

