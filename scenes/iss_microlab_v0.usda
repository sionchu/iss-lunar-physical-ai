    def Xform "Task"
    {
        def Xform "Targets"
        {
            def Xform "MaintenancePanel"
            {
                custom rel iss:affordance = </World/Environment/ISS/Affordances/MaintenancePanel_Target>
                float3 xformOp:rotateXYZ = (0, 0, 0)
                double3 xformOp:translate = (1.25, -0.97, -0.15)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            }
        }

        def Xform "Waypoints"
        {
            def Sphere "R2_Park" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom token iss:affordance = "approach_park"
                custom rel iss:graspCandidates = </World/Environment/ISS/Affordances/Handrail_B_Graspable>
                rel material:binding = </World/Looks/AffordanceWaypoint>
                double radius = 0.035
                float3 xformOp:rotateXYZ = (0, 0, 0)
                double3 xformOp:translate = (0.7, -0.35, 0.05)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            }
        }
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 0
    }

    def Scope "Looks"
    {
        def Material "R2ShellPlain"
        {
            token outputs:surface.connect = </World/Looks/R2ShellPlain/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.86, 0.84)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "CollisionProxyBounds"
        {
            token outputs:surface.connect = </World/Looks/CollisionProxyBounds/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.61, 0.62)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "CollisionProxyTask"
        {
            token outputs:surface.connect = </World/Looks/CollisionProxyTask/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.56, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "CollisionContext"
        {
            token outputs:surface.connect = </World/Looks/CollisionContext/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.31, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "AffordanceGraspable"
        {
            token outputs:surface.connect = </World/Looks/AffordanceGraspable/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.65, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "AffordanceMaintenance"
        {
            token outputs:surface.connect = </World/Looks/AffordanceMaintenance/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.55, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "AffordanceWaypoint"
        {
            token outputs:surface.connect = </World/Looks/AffordanceWaypoint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.92)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "Cameras"
    {
        def Camera "Hero"
        {
            float2 clippingRange = (0.02, 60)
            float focalLength = 18
            float fStop = 0
            float horizontalAperture = 36
            float verticalAperture = 20.25
            matrix4d xformOp:transform = ( (-0.16439898730535726, -0.9863939238321437, 0, 0), (0.050897358239660136, -0.008482893039943356, 0.9986678624296952, -0), (-0.9850799114270866, 0.16417998523784777, 0.051599423931895004, 0), (-3, 0.45, 0.19999999999999998, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
