                )
                {
                    custom string iss:module = "Node 2 Harmony"
                    custom string iss:poseSource = "astrobee_iss/urdf/model.urdf <visual> origin"
                    custom string iss:sourceMesh = "nasa/astrobee_media@1cb0620 astrobee_iss/meshes/node_2.dae"
                    float3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:translate = (10.9744206, -0.0112558, 4.8358958)
