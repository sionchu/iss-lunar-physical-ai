            def Xform "Visual"
            {
                def Xform "USLab" (
                    prepend references = @../assets/cache/iss_media/us_lab.usd@
                )
                {
                    float3 xformOp:rotateXYZ = (90, 0, 0)
                    float3 xformOp:scale = (1.0858, 1.0858, 1.0858)
                    double3 xformOp:translate = (4.2, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
                }

                def Xform "Handrail_A" (
                    prepend references = @../assets/cache/iss_media/handrail_30.usd@
