#usda 1.0
(
    "Full ISS interior v0 (USOS modules in nasa/astrobee_media). Visual: NASA meshes posed by astrobee_iss/urdf/model.urdf. Collision: US Lab S1 proxies + triangle meshes elsewhere. Not a digital twin. Built by scripts/build_iss_full.py"
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    variants = {
        string truthLayer = "visual"
    }
    prepend variantSets = "truthLayer"
)
{
    def Xform "Environment"
    {
        def Xform "ISS"
        {
            custom string iss:frame = "children are in the Astrobee ISS world frame (x fwd, y starboard, z nadir); this prim rotates it 180 deg about x so scene +Z = zenith"
            custom string[] iss:knownGaps = ["PMM Leonardo", "Quest airlock", "JEM ELM-PS logistics module", "Russian segment (FGB/SM/MRM/MLM)", "PMA-2/PMA-3 and visiting vehicles", "ISS handrail layout outside the US Lab (no public source)"]
            custom string iss:license = "astrobee_iss/package.xml: Apache-2.0; astrobee_media readme: all multimedia covered by NASA Media Usage Guidelines; interior meshes from NASA 3D Resources ISS Internal (IGOAL). Governing terms UNKNOWN."
            custom string iss:sourceUrdf = "nasa/astrobee_media@1cb0620 astrobee_iss/urdf/model.urdf sha256 38a1de2fb42a65d7cb98fb1a59da0bcd1d5d8cf2439db65fe3b689fd60a94cda"
            float xformOp:rotateX:stationToScene = 180
            uniform token[] xformOpOrder = ["xformOp:rotateX:stationToScene"]

            def Xform "Visual"
            {
                def Xform "Node1" (
                    prepend references = @../assets/cache/iss_media/node_1.usd@
                )
                {
                    custom string iss:module = "Node 1 Unity"
                    custom string iss:poseSource = "astrobee_iss/urdf/model.urdf <visual> origin"
                    custom string iss:sourceMesh = "nasa/astrobee_media@1cb0620 astrobee_iss/meshes/node_1.dae"
                    float3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:translate = (-4.4630848, -0.0027432, 4.8508666)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
                }

                def Xform "USLab" (
                    prepend references = @../assets/cache/iss_media/us_lab.usd@
                )
                {
                    custom double3 iss:collisionOriginXyz = (6.4125472, 0.006477, 4.834892)
                    custom string iss:module = "US Lab Destiny"
                    custom string iss:originStatus = "UNKNOWN which origin is correct: URDF visual and collision origins differ; visual origin used"
                    custom string iss:poseSource = "astrobee_iss/urdf/model.urdf <visual> origin (collision origin differs; see iss:collisionOriginXyz)"
                    custom string iss:sourceMesh = "nasa/astrobee_media@1cb0620 astrobee_iss/meshes/us_lab.dae"
                    float3 xformOp:rotateXYZ = (179.99469, 0, 0)
                    float3 xformOp:scale = (1.0858, 1.0858, 1.0858)
                    double3 xformOp:translate = (6.3085472, 0.006477, 4.834892)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
                }

