#usda 1.0
(
    "ISS Micro-Lab (S1). Visual: NASA US Lab interior + ISS handrail meshes (nasa/astrobee_media, Apache-2.0). Collision/affordance: authored proxies. R2 is KINEMATIC / VISUAL ONLY. Built by scripts/build_iss_microlab.py"
    defaultPrim = "World"
    endTimeCode = 240
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 30
    upAxis = "Z"
)

def Xform "World" (
    variants = {
        string truthLayer = "visual"
    }
    prepend variantSets = "truthLayer"
)
{
    def Xform "Environment"
